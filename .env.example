# Copy to backend/.env (backend) and frontend/.env (frontend) and adjust.

# --- backend/.env ---
# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# Signs login tokens (JWTs). REQUIRED, and must be secret and random.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Optional. Defaults to a SQLite file in backend/; use a postgresql:// URL in production
# DATABASE_URL=sqlite:///./joblogga.db  (default: backend/joblogga.db)

# Rate limits are per client address. With nothing in front of the API (local
# development) leave both of these unset and the connection address is used.
# Behind a host's proxies the connection address is the proxy's (or forgeable), so:
#   TRUSTED_CLIENT_IP_HEADER: a header the host's edge sets and clients cannot forge
#                             (Render: cf-connecting-ip)
#   TRUSTED_PROXY_HOPS:       fallback, counts X-Forwarded-For entries from the right
#                             (Render: 3)
TRUSTED_CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=0

# Password reset emails, sent through Resend (https://resend.com).
# RESEND_API_KEY is a secret: set it only in the host's dashboard (and your own .env), never commit it.
# Leave it empty in development: no email is sent.
RESEND_API_KEY=
EMAIL_FROM=Joblogga <noreply@dolocozy.com>
# Where the frontend lives; the link in the email points here (no trailing slash).
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
# DEVELOPMENT ONLY: with no RESEND_API_KEY, print the reset link in the server log so the
# flow can be tried. A link in a log is a working password reset, so never turn this on in production.
LOG_RESET_LINKS=false

# How long a login lasts
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- production (set in the hosting dashboards, never committed) ---
# Render (backend):  DATABASE_URL = your Neon connection string (postgresql://...),
#                    CORS_ORIGINS = https://<your-vercel-domain>, SECRET_KEY is generated for you.
# Vercel (frontend): VITE_API_URL = https://<your-render-service>.onrender.com

# --- frontend/.env ---
# Base URL of the backend API
VITE_API_URL=http://localhost:8000
